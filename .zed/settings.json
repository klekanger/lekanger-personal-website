// Zed settings for this repo.
//
// Biome owns JS/TS/JSON/CSS formatting here. Without these overrides Zed's
// default `"formatter": "auto"` uses its bundled Prettier, which disagrees
// with `pnpm format` (Biome) on indentation, quotes and trailing commas — so
// saving a file and running the CLI produce different output.
//
// Indentation itself is set in the root biome.json (`formatter.indentStyle:
// "space"`, `indentWidth: 2`); the `tab_size` below only affects manual
// tabbing and any file Biome doesn't handle.
{
  "tab_size": 2,
  "hard_tabs": false,
  "languages": {
    "JavaScript": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": { "source.organizeImports.biome": true }
    },
    "TypeScript": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": { "source.organizeImports.biome": true }
    },
    "TSX": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": { "source.organizeImports.biome": true }
    },
    "JSON": {
      "formatter": { "language_server": { "name": "biome" } }
    },
    "JSONC": {
      "formatter": { "language_server": { "name": "biome" } }
    },
    "CSS": {
      "formatter": { "language_server": { "name": "biome" } }
    }
  }
}
